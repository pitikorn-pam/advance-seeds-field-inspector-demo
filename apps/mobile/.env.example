# Copy to .env. Expo CLI auto-loads it on `expo start` and inlines any var
# prefixed with EXPO_PUBLIC_ as `process.env.EXPO_PUBLIC_*` at build time.
#
# For local dev against the Docker stack:
#   API_URL  → EXPO_PUBLIC_SUPABASE_URL
#   ANON_KEY → EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# For demo / production: point at the cloud project.

EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey<ANON_KEY>
