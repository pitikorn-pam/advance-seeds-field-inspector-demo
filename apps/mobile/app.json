{
  "expo": {
    "name": "Advance Seeds Field Inspector",
    "slug": "advance-seeds-field-inspector",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "advanceseeds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.advanceseeds.fieldinspector"
    },
    "android": {
      "package": "com.advanceseeds.fieldinspector",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#0F0F11" }
        }
      ],
      "expo-router",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
