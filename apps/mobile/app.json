{
  "expo": {
    "name": "Advance Seeds Field Inspector",
    "slug": "advance-seeds-field-inspector",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "advanceseeds",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.advanceseeds.fieldinspector",
      "infoPlist": {
        "NSCameraUsageDescription": "Advance Seeds needs camera access to detect and measure seeds.",
        "NSPhotoLibraryAddUsageDescription": "Advance Seeds saves snapshots and recordings to your photo library when you ask it to.",
        "NSMicrophoneUsageDescription": "Advance Seeds records audio with videos to capture field notes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.advanceseeds.fieldinspector",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Advance Seeds needs camera access to detect and measure seeds.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Advance Seeds records audio with videos to capture field notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1783aa09-3848-4373-9a3b-7c1e23205388"
      }
    },
    "owner": "phongsakorn.p",
    "runtimeVersion": "0.2.0",
    "updates": {
      "url": "https://u.expo.dev/1783aa09-3848-4373-9a3b-7c1e23205388"
    }
  }
}
