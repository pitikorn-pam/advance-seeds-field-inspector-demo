{
  "name": "@advance-seeds/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens generated from docs/handoff/design-tokens.json — Tailwind preset, CSS vars, and TS export.",
  "type": "module",
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tailwind.preset": "./dist/tailwind.preset.cjs",
    "./css-vars.css": "./dist/css-vars.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx src/build.ts",
    "test": "node --test src/build.test.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1"
  }
}
