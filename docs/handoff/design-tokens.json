{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "Advance Seeds Field Inspector",
    "version": "2.0.0",
    "description": "Canonical Notion-inspired design tokens for the Advance Seeds mobile inspector and companion dashboard."
  },

  "color": {
    "brand": {
      "primary": {
        "value": "#6E40E0",
        "darkValue": "#8F75FF",
        "description": "Signature purple primary action. Use for dominant CTAs, active states, and primary progress."
      },
      "primaryPressed": {
        "value": "#5A2EC8",
        "darkValue": "#A492FF",
        "description": "Pressed state for the signature purple action."
      },
      "primaryDeep": {
        "value": "#4B22A8",
        "darkValue": "#D8D0FF",
        "description": "Deep purple emphasis and high-contrast tag text."
      },
      "soft": {
        "value": "#E8E0F4",
        "darkValue": "#2A2054",
        "description": "Soft purple surface for selected tabs and quiet emphasis."
      },
      "deep": {
        "value": "#2D205E",
        "darkValue": "#D8D0FF",
        "description": "Deep purple text on purple-tinted surfaces."
      },
      "navy": {
        "value": "#0D1028",
        "darkValue": "#07091A",
        "description": "Deep navy hero and empty-state band."
      },
      "navyDeep": {
        "value": "#07091A",
        "darkValue": "#050615",
        "description": "Deeper navy for camera and promotional bands."
      },
      "navyMid": {
        "value": "#1C2445",
        "darkValue": "#20294F",
        "description": "Mid navy used for panels on dark bands."
      },
      "linkBlue": {
        "value": "#2563EB",
        "darkValue": "#93C5FD",
        "description": "Inline link blue. Do not use as the primary CTA."
      },
      "linkBluePressed": {
        "value": "#1D4ED8",
        "darkValue": "#BFDBFE",
        "description": "Pressed state for inline links."
      },
      "seedGreen": {
        "value": "#0F6E56",
        "darkValue": "#5DCAA5",
        "description": "Advance Seeds domain accent for seed, calibration, and success-adjacent signals."
      },
      "pink": { "value": "#E255A1", "darkValue": "#F4A8D2" },
      "orange": { "value": "#F77B23", "darkValue": "#FDBA74" },
      "teal": { "value": "#11A78B", "darkValue": "#7DD3C7" },
      "green": { "value": "#43A047", "darkValue": "#A7D98C" },
      "yellow": { "value": "#F2C94C", "darkValue": "#FFE08A" },
      "brown": { "value": "#8C5E3C", "darkValue": "#D6B08C" }
    },
    "cardTint": {
      "peach": { "value": "#FBEBD9", "darkValue": "#412314" },
      "rose": { "value": "#FBE0E2", "darkValue": "#442033" },
      "mint": { "value": "#DEEDD7", "darkValue": "#123A31" },
      "lavender": { "value": "#E8E0F4", "darkValue": "#2A2054" },
      "sky": { "value": "#DAE9F2", "darkValue": "#122A44" },
      "yellow": { "value": "#FAEFC8", "darkValue": "#40350B" },
      "yellowBold": { "value": "#FFE082", "darkValue": "#F4C430" },
      "cream": { "value": "#FAF6EC", "darkValue": "#2D281C" },
      "gray": { "value": "#EFEEEA", "darkValue": "#1F1F22" }
    },
    "grade": {
      "comment": "Grade ink colors paired with cardTint backgrounds for GradeChip. Mint → A, Yellow → B, Peach → C, Rose → reject.",
      "a":      { "bg": "#DEEDD7", "ink": "#2D6E3F" },
      "b":      { "bg": "#FAEFC8", "ink": "#7A5A12" },
      "c":      { "bg": "#FBEBD9", "ink": "#B85518" },
      "reject": { "bg": "#FBE0E2", "ink": "#A02828" }
    },
    "background": {
      "primary": {
        "value": "#FFFFFF",
        "darkValue": "#111114",
        "description": "Canvas white and primary card surface."
      },
      "secondary": {
        "value": "#F7F6F2",
        "darkValue": "#19191D",
        "description": "Notion-like surface for app screens and grouped controls."
      },
      "tertiary": {
        "value": "#FBFAF7",
        "darkValue": "#222228",
        "description": "Subtle section background and elevated neutral."
      }
    },
    "text": {
      "primary": { "value": "#171717", "darkValue": "#F7F7F5" },
      "secondary": { "value": "#5F5F5B", "darkValue": "#B6B6B0" },
      "tertiary": { "value": "#8C8C87", "darkValue": "#7E7E78" },
      "onDark": { "value": "#FFFFFF", "darkValue": "#FFFFFF" },
      "onDarkMuted": { "value": "rgba(255,255,255,0.72)", "darkValue": "rgba(255,255,255,0.72)" }
    },
    "border": {
      "tertiary": {
        "value": "rgba(23,23,23,0.08)",
        "darkValue": "rgba(255,255,255,0.08)"
      },
      "secondary": {
        "value": "rgba(23,23,23,0.14)",
        "darkValue": "rgba(255,255,255,0.16)"
      },
      "primary": {
        "value": "rgba(23,23,23,0.24)",
        "darkValue": "rgba(255,255,255,0.26)"
      }
    },
    "semantic": {
      "success": {
        "bg": { "value": "#E4F4DA", "darkValue": "#173404" },
        "text": { "value": "#285B12", "darkValue": "#C0DD97" }
      },
      "warning": {
        "bg": { "value": "#FFF1B8", "darkValue": "#40350B" },
        "text": { "value": "#704B00", "darkValue": "#FFE08A" }
      },
      "danger": {
        "bg": { "value": "#FFE2E0", "darkValue": "#501313" },
        "text": { "value": "#8A1F1B", "darkValue": "#F7C1C1" }
      },
      "info": {
        "bg": { "value": "#E2F0FF", "darkValue": "#122A44" },
        "text": { "value": "#1957A4", "darkValue": "#B5D4F4" }
      }
    },
    "variety": {
      "comment": "Database-style pastel family cards for the variety library and setup picker.",
      "corn": { "bg": "#FFF1B8", "text": "#704B00" },
      "rice": { "bg": "#DFF6EC", "text": "#0F6E56" },
      "legume": { "bg": "#EEE9FF", "text": "#3F249B" },
      "mungbean": { "bg": "#FFE8D6", "text": "#8C3C12" }
    },
    "glass": {
      "comment": "Translucent surfaces for camera viewfinder chrome. These sit on top of live preview and do not change by theme.",
      "chip": { "value": "rgba(7, 9, 26, 0.42)" },
      "soft": { "value": "rgba(7, 9, 26, 0.52)" },
      "surface": { "value": "rgba(7, 9, 26, 0.64)" },
      "strong": { "value": "rgba(7, 9, 26, 0.78)" },
      "border": { "value": "rgba(255, 255, 255, 0.18)" },
      "text": { "value": "#FFFFFF" },
      "textMuted": { "value": "rgba(255, 255, 255, 0.72)" },
      "accent": { "value": "rgba(255, 216, 77, 0.9)" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": {
        "value": "'Notion Sans', Inter, -apple-system, system-ui, 'Segoe UI', Helvetica, sans-serif"
      },
      "mono": { "value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace" }
    },
    "scale": {
      "display": { "size": 34, "weight": 600, "lineHeight": 1.08, "letterSpacing": "-0.02em" },
      "h1": { "size": 24, "weight": 600, "lineHeight": 1.15, "letterSpacing": "-0.01em" },
      "h2": { "size": 19, "weight": 600, "lineHeight": 1.25, "letterSpacing": "0" },
      "title": { "size": 15, "weight": 500, "lineHeight": 1.35, "letterSpacing": "0" },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.55, "letterSpacing": "0" },
      "caption": { "size": 12, "weight": 400, "lineHeight": 1.4, "letterSpacing": "0" },
      "label": { "size": 11, "weight": 600, "lineHeight": 1.3, "letterSpacing": "0.04em" }
    }
  },

  "spacing": {
    "xs": { "value": 4 },
    "sm": { "value": 8 },
    "md": { "value": 12 },
    "lg": { "value": 16 },
    "xl": { "value": 20 },
    "2xl": { "value": 24 },
    "3xl": { "value": 32 },
    "4xl": { "value": 40 },
    "section": { "value": 64 },
    "hero": { "value": 96 }
  },

  "radius": {
    "xs": { "value": 4 },
    "sm": { "value": 6 },
    "md": { "value": 8 },
    "lg": { "value": 12 },
    "xl": { "value": 16 },
    "2xl": { "value": 20 },
    "full": { "value": 9999 }
  },

  "elevation": {
    "subtle": { "value": "rgba(15,15,15,0.04) 0px 1px 2px 0px" },
    "card": { "value": "rgba(15,15,15,0.08) 0px 4px 12px 0px" },
    "mockup": { "value": "rgba(15,15,15,0.20) 0px 24px 48px -8px" },
    "modal": { "value": "rgba(15,15,15,0.16) 0px 16px 48px -8px" }
  },

  "component": {
    "button": {
      "height": 44,
      "radius": 8,
      "paddingX": 18,
      "fontSize": 14,
      "fontWeight": 500
    },
    "input": {
      "height": 44,
      "radius": 8,
      "paddingX": 14,
      "fontSize": 15,
      "borderWidth": 1,
      "focusRingWidth": 2
    },
    "pill": {
      "height": 26,
      "radius": 9999,
      "paddingX": 10,
      "fontSize": 12,
      "fontWeight": 600
    },
    "card": {
      "radius": 12,
      "paddingY": 16,
      "paddingX": 18,
      "borderWidth": 1
    },
    "statTile": {
      "radius": 12,
      "paddingY": 14,
      "paddingX": 12,
      "valueSize": 22,
      "labelSize": 11
    },
    "tabBar": {
      "height": 80,
      "iconSize": 22,
      "labelSize": 10
    },
    "iconButton": {
      "size": 40,
      "radius": 8
    },
    "toggle": {
      "width": 50,
      "height": 30,
      "knobSize": 24,
      "radius": 9999
    },
    "listRow": {
      "minHeight": 56,
      "paddingY": 14,
      "paddingX": 4,
      "thumbSize": 44,
      "thumbRadius": 12,
      "gap": 14
    }
  },

  "motion": {
    "duration": {
      "fast": { "value": 120 },
      "normal": { "value": 180 },
      "slow": { "value": 280 }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0.0, 0.2, 1)" },
      "decelerate": { "value": "cubic-bezier(0.0, 0.0, 0.2, 1)" },
      "accelerate": { "value": "cubic-bezier(0.4, 0.0, 1, 1)" }
    }
  }
}
