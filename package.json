{
  "name": "advance-seeds-field-inspector-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Advance Seeds Field Inspector — presale demo (web dashboard + Expo mobile + Supabase).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:types": "pnpm -F @advance-seeds/supabase types",
    "supabase:seed-users": "pnpm -F @advance-seeds/supabase seed-users",
    "supabase:seed-all": "pnpm -F @advance-seeds/supabase seed-all",
    "supabase:start": "pnpm -F @advance-seeds/supabase start",
    "supabase:stop": "pnpm -F @advance-seeds/supabase stop",
    "supabase:smoke": "pnpm -F @advance-seeds/supabase smoke",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-i18next": "^6.1.0",
    "typescript-eslint": "^8.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
