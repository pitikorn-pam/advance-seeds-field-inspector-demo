# Hoist NativeWind's runtime peers so Metro can resolve them.
# Without this, react-native-css-interop (NativeWind's runtime) lives in
# .pnpm/<hash>/node_modules but isn't on the resolver path Metro searches.
public-hoist-pattern[]=*react-native-css-interop*
public-hoist-pattern[]=*nativewind*

# Standard pnpm hoist patterns kept (these are the defaults; listing them
# explicitly because adding any public-hoist-pattern overrides defaults).
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*

# Allow Metro / RN tooling to walk up node_modules trees the way it expects
shamefully-hoist=false
